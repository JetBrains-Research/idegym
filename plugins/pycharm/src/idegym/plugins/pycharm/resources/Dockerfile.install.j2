# Install PyCharm {{ version }}
# https://www.jetbrains.com/pycharm/download/other.html
# Requires 2026.1.1+; older versions are not supported.
#
# PyCharm has no headless mode, so Xvfb is always installed and the start script runs the IDE
# against a virtual display; see the PyCharm plugin docstring.
USER root
RUN set -eux; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl unzip xvfb procps socat xdotool \
        libxtst6 libxrender1 libxi6 libfreetype6 fontconfig; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

ENV PYCHARM_VERSION="{{ version }}"
ENV IDE_DIR="/opt/pycharm"
ENV IDE_CONFIG_PATH="{{ config_dir }}"
RUN set -eux; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in \
        amd64) suffix="" ;; \
        arm64) suffix="-aarch64" ;; \
        *) echo "Unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    archive="pycharm-{{ version }}${suffix}.tar.gz"; \
    curl -fsSL "https://download.jetbrains.com/python/${archive}" -o /tmp/pycharm.tar.gz; \
    curl -fsSL "https://download.jetbrains.com/python/${archive}.sha256" -o /tmp/pycharm.sha256; \
    expected=$(cut -d' ' -f1 /tmp/pycharm.sha256); \
    echo "$expected  /tmp/pycharm.tar.gz" | sha256sum -c -; \
    mkdir -p ${IDE_DIR}; \
    tar -xzf /tmp/pycharm.tar.gz -C ${IDE_DIR} --strip-components=1; \
    rm /tmp/pycharm.tar.gz /tmp/pycharm.sha256

ENV JAVA_HOME="${IDE_DIR}/jbr"
ENV PATH="${JAVA_HOME}/bin:${IDE_DIR}/bin:${PATH}"
ENV DISPLAY=":99"
# IDE-specific config for the shared start-ide entrypoint (installed as /usr/local/bin/start-ide).
# PyCharm has no headless mode, so IDE_SUPPORTS_HEADLESS=false and the entrypoint always starts Xvfb.
ENV IDE_NAME="PyCharm"
ENV IDE_LAUNCHER="pycharm.sh"
ENV IDE_LOG_FILE="/tmp/pycharm.log"
ENV IDE_LAUNCH_ARGS="-Dide.show.tips.on.startup.default.value=false -Djb.consents.confirmation.enabled=false"
ENV IDE_SUPPORTS_HEADLESS="false"

# Append JVM/startup flags to vmoptions, one per line so the list stays readable and reviewable.
# These apply to every JVM invocation (including inspect.sh): -Didea.config.path avoids XDG
# detection failures, -Dide.trust.all.projects suppresses the "Trust Project?" dialog, and the
# rest suppress first-run/consent/update dialogs and tune the JVM for containers.
RUN set -eux; \
    for f in "${IDE_DIR}/bin/pycharm64.vmoptions" "${IDE_DIR}/bin/pycharm.vmoptions"; do \
        [ -f "$f" ] || continue; \
        printf '%s\n' \
            '' \
            '-Didea.config.path={{ config_dir }}' \
            '-Dide.trust.all.projects=true' \
            '-Djb.privacy.policy.text=<!--999.999-->' \
            '-Dide.firstStartup=false' \
            '-Dide.no.platform.update=true' \
            '-Djb.consents.confirmation.enabled=false' \
            '-Dide.show.tips.on.startup.default.value=false' \
            '-Dide.browser.jcef.enabled=false' \
            '-Dsun.net.client.defaultConnectTimeout=5000' \
            '-Dsun.net.client.defaultReadTimeout=10000' \
            '-XX:-UsePerfData' \
            '-XX:+PerfDisableSharedMem' \
            '-XX:-UseLargePages' \
            '-Xshare:off' \
            '-XX:+UseContainerSupport' \
            '-XX:ErrorFile=/tmp/jvm-crash.log' \
            >> "$f"; \
    done
