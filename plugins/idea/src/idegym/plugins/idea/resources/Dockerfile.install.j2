# Install IntelliJ IDEA Community {{ version }}
# https://www.jetbrains.com/idea/download/other.html
#
# Headless by default. When headless=False the image also installs Xvfb (+ xdotool) so the
# start script can launch the IDE against a virtual display; see the Idea plugin docstring.
USER root
RUN set -eux; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl unzip procps socat \
        libx11-6 libxext6 libxrender1 libxtst6 libxi6 libxrandr2 \
        libfreetype6 libfontconfig1{% if not headless %} \
        xvfb xdotool{% endif %}; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

ENV IDEA_VERSION="{{ version }}"
ENV IDE_DIR="/opt/idea"
ENV IDE_CONFIG_PATH="{{ config_dir }}"
RUN set -eux; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in \
        amd64) suffix="" ;; \
        arm64) suffix="-aarch64" ;; \
        *) echo "Unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    archive="idea-{{ version }}${suffix}.tar.gz"; \
    curl -fsSL "https://download.jetbrains.com/idea/${archive}" -o /tmp/idea.tar.gz; \
    curl -fsSL "https://download.jetbrains.com/idea/${archive}.sha256" -o /tmp/idea.sha256; \
    expected=$(cut -d' ' -f1 /tmp/idea.sha256); \
    echo "$expected  /tmp/idea.tar.gz" | sha256sum -c -; \
    mkdir -p ${IDE_DIR}; \
    tar -xzf /tmp/idea.tar.gz -C ${IDE_DIR} --strip-components=1; \
    rm /tmp/idea.tar.gz /tmp/idea.sha256

ENV JAVA_HOME="${IDE_DIR}/jbr"
ENV PATH="${JAVA_HOME}/bin:${IDE_DIR}/bin:${PATH}"
# IDE-specific config for the shared start-ide entrypoint (installed as /usr/local/bin/start-ide).
ENV IDE_NAME="IntelliJ IDEA"
ENV IDE_LAUNCHER="idea.sh"
ENV IDE_LOG_FILE="/tmp/idea.log"
ENV IDE_LAUNCH_ARGS="-Didea.platform.prefix=Idea"
ENV IDE_SUPPORTS_HEADLESS="true"
# IDEA_HEADLESS picks true headless mode vs a virtual display (Xvfb).
ENV IDEA_HEADLESS="{{ 'true' if headless else 'false' }}"
{% if not headless %}
ENV DISPLAY=":99"
{% endif %}
# Append startup-suppression flags to vmoptions, one per line so the list stays readable and
# reviewable. Headless builds force -Djava.awt.headless=true; virtual-display builds must NOT
# (they would ignore the Xvfb DISPLAY) and instead suppress the EUA / first-run dialogs.
RUN set -eux; \
    for f in "${IDE_DIR}/bin/idea64.vmoptions" "${IDE_DIR}/bin/idea.vmoptions"; do \
        [ -f "$f" ] || continue; \
        printf '%s\n' \
            '' \
{% if headless %}            '-Djava.awt.headless=true' \
{% else %}            '-Djb.privacy.policy.text=<!--999.999-->' \
            '-Dide.firstStartup=false' \
{% endif %}            '-Didea.trust.all.projects=true' \
            '-Djb.consents.confirmation.enabled=false' \
            '-Dide.show.tips.on.startup.default.value=false' \
            '-Dide.no.platform.update=true' \
            '-Dide.browser.jcef.enabled=false' \
            '-XX:-UsePerfData' \
            '-XX:+PerfDisableSharedMem' \
            '-XX:+UseContainerSupport' \
            '-XX:ErrorFile=/tmp/jvm-crash.log' \
            >> "$f"; \
    done
