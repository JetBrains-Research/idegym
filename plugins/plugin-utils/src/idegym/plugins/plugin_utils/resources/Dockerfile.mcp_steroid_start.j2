# Configure {{ ide_name }} to start without a project and wait for mcp-steroid.
# Agents can open any project at runtime via the mcp-steroid MCP tools.
#
# MCP_STEROID=true switches the start-ide entrypoint to mcp-steroid mode: no project arg,
# waits for mcp-steroid on {{ mcp_steroid_port }}, then bridges
# 0.0.0.0:{{ mcp_steroid_bridge_port }} -> 127.0.0.1:{{ mcp_steroid_port }} via socat.
# The entrypoint scripts + supervisord program are appended by render() (render_entrypoint_install).
ENV MCP_STEROID=true
