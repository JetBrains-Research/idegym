FROM python:3.12-slim

WORKDIR /app

# Mirrors the server image (Dockerfile.jinja): a non-root `appuser` with passwordless sudo, plus
# a `devuser` without it, so the tests can exercise `user=` through runuser (as root), through
# sudo (as appuser), and its rejection (as devuser).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends sudo; \
    rm -rf /var/lib/apt/lists/*; \
    useradd -m -s /bin/bash appuser; \
    useradd -m -s /bin/bash devuser; \
    echo "appuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/appuser; \
    chmod 0440 /etc/sudoers.d/appuser

# Copy the project files
COPY integration-tests integration-tests/
COPY backend-utils backend-utils/
COPY common-utils common-utils/
COPY api api/

# Install dependencies
RUN pip install --no-cache-dir \
                -e ./api \
                -e ./backend-utils \
                -e ./common-utils \
                pytest>=8.4.1 \
                pytest-asyncio>=1.1.0

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# TODO: support uv to be able running other tests
CMD ["sh", "-c", "pytest integration-tests/test_bash_executor.py -v --run-docker; exit 0"]
